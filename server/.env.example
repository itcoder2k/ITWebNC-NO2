PORT=5000
NODE_ENV=development

# Database configuration (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=your_mysql_password
DB_NAME=GameAssetDB

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Upload configuration
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800 # 50MB
